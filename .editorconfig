# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java and Gradle: 4-space indentation, no tabs
[*.{java,gradle}]
indent_style = space
indent_size = 4
tab_width = 4
block_comment_start = /*
block_comment = *
block_comment_end = */

# Choreo paths: generated by Choreo, one space per indent level in .chor
[*.chor]
indent_style = space
indent_size = 1

# Choreo trajectories: generated by Choreo, mixed widths (waypoint objects use 4 spaces), so only spaces, no tabs
[*.traj]
indent_style = space
